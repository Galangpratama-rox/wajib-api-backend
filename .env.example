# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── Proxy mode ───────────────────────────────────────────────────────────────
# true  → aktifkan ScraperAPI (untuk IP yang diblokir Kuramanime, e.g. Railway)
# false → direct fetch + Puppeteer lokal (untuk development / IP tidak diblok)
USE_PROXY=false

# ─── ScraperAPI Keys (hanya dipakai kalau USE_PROXY=true) ────────────────────
# Isi dengan key kamu, pisahkan dengan koma kalau lebih dari satu
SCRAPER_API_KEYS=

# ─── Puppeteer / Chromium ────────────────────────────────────────────────────
# Lokasi Chrome/Chromium executable
# Windows  : kosongkan (otomatis pakai Chrome default di Program Files)
# Linux    : /usr/bin/chromium-browser atau /usr/bin/google-chrome
# Docker   : /usr/bin/chromium-browser
# CHROME_PATH=

# ─── Redis Cache ─────────────────────────────────────────────────────────────
# URL koneksi Redis (Railway Redis plugin otomatis mengisi ini)
# Format: redis://:<password>@<host>:<port>
# Kalau tidak di-set, aplikasi tetap jalan tanpa Redis (LRU in-memory only)
REDIS_URL=

# TTL cache (dalam detik) — bisa dikonfigurasi per tipe source
# TTL untuk HTML scraping (Otakudesu, Kuramanime) — default 600 detik (10 menit)
CACHE_TTL_SCRAPE=600
# TTL untuk direct REST API call (Komiknesia) — default 300 detik (5 menit)
CACHE_TTL_API=300
# Fallback TTL kalau CACHE_TTL_SCRAPE/CACHE_TTL_API tidak di-set
CACHE_TTL_SECONDS=600

# ─── Concurrency Limits ──────────────────────────────────────────────────────
# Maks request HTML scraping yang berjalan paralel (lebih berat, rawan diblokir)
SCRAPE_CONCURRENCY=3
# Maks request direct REST API yang berjalan paralel
API_CONCURRENCY=8

# ─── Request Timeouts ────────────────────────────────────────────────────────
# Timeout untuk HTML scraping dalam milidetik (default 20000ms = 20 detik)
SCRAPE_TIMEOUT_MS=20000
# Timeout untuk direct REST API dalam milidetik (default 10000ms = 10 detik)
API_TIMEOUT_MS=10000
