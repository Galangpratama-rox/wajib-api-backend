# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001

# ─── Proxy mode ───────────────────────────────────────────────────────────────
# true  → aktifkan ScraperAPI (untuk IP yang diblokir Kuramanime, e.g. Railway)
# false → direct fetch + Puppeteer lokal (untuk development / IP tidak diblok)
USE_PROXY=false

# ─── ScraperAPI Keys (hanya dipakai kalau USE_PROXY=true) ────────────────────
# Isi dengan key kamu, pisahkan dengan koma kalau lebih dari satu
SCRAPER_API_KEYS=

# ─── Puppeteer / Chromium ────────────────────────────────────────────────────
# Lokasi Chrome/Chromium executable
# Windows  : kosongkan (otomatis pakai Chrome default di Program Files)
# Linux    : /usr/bin/chromium-browser atau /usr/bin/google-chrome
# Docker   : /usr/bin/chromium-browser
# CHROME_PATH=
